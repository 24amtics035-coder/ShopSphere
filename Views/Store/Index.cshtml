
@model IEnumerable<ShopSphere.Models.Product>

@{
    ViewData["Title"] = "ShopSphere Store";
    var categories = ViewBag.Categories
        as IEnumerable<ShopSphere.Models.Category>
        ?? Enumerable.Empty<ShopSphere.Models.Category>();
}

<div class="container py-4">
    <section class="rounded-4 p-4 p-md-5 mb-5 text-white"
             style="background: linear-gradient(120deg, #111827, #4338ca);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-warning text-dark mb-3">
                    SHOPSPHERE COLLECTION
                </span>
                <h1 class="display-5 fw-bold">
                    Find Your Next Favourite
                </h1>
                <p class="lead">
                    Explore products selected for your everyday lifestyle.
                </p>
                <a href="#products" class="btn btn-light btn-lg">
                    Explore Products
                </a>
            </div>
            <div class="col-md-4 text-center mt-4 mt-md-0">
                <span style="font-size: 100px;">🛍️</span>
            </div>
        </div>
    </section>

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" id="products">Our Products</h2>
            <p class="text-muted mb-0">Discover something you love.</p>
        </div>

        <form asp-controller="Store" asp-action="Index"
              method="get" class="d-flex flex-wrap gap-2">
            <input type="search" name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search products..." />

            <select name="categoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in categories)
                {
                    if (ViewBag.CategoryId != null &&
                        (int)ViewBag.CategoryId == category.CategoryId)
                    {
                        <option value="@category.CategoryId" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.CategoryId">
                            @category.Name
                        </option>
                    }
                }
            </select>

            <button class="btn btn-primary" type="submit">
                Search
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info rounded-3">
            No products found. Add products through the
            <a asp-controller="Products" asp-action="Index">
                product management page
            </a>.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2
                    row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 class="card-img-top"
                                 alt="@product.Name"
                                 style="height:220px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center
                                        justify-content-center bg-light"
                                 style="height:220px;font-size:70px;">
                                🛍️
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <span class="small text-muted">
                                @(product.Category?.Name ?? "General")
                            </span>

                            <h5 class="card-title fw-bold mt-2">
                                @product.Name
                            </h5>

                            <p class="card-text text-muted small">
                                @product.Description
                            </p>

                            <div class="mt-auto">
                                <div class="fw-bold fs-5 mb-3">
                                    ₹@product.Price.ToString("N2")
                                </div>

                                @if (product.Stock > 0)
                                {
                                    <span class="badge bg-success mb-3">
                                        In stock
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger mb-3">
                                        Out of stock
                                    </span>
                                }

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="btn btn-outline-dark w-100">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
