
@model ShopSphere.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container py-4" style="max-width: 800px;">
    <h1 class="fw-bold mb-4">Product Details</h1>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     class="img-fluid rounded mb-3"
                     style="max-height:300px;" />
            }

            <h2>@Model.Name</h2>
            <p class="text-muted">@Model.Description</p>
            <h4 class="text-primary">@Model.Price.ToString("C")</h4>
            <p><strong>Stock:</strong> @Model.Stock</p>
            <p><strong>Category:</strong>
                @(Model.Category?.Name ?? "Uncategorized")
            </p>

            <a asp-action="Edit" asp-route-id="@Model.ProductId"
               class="btn btn-primary">Edit</a>
            <a asp-action="Index"
               class="btn btn-outline-secondary">Back to Products</a>
        </div>
    </div>
</div>
